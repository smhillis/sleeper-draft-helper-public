{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whotodraftnext.com/schemas/actual-player-production-fixture.json",
  "title": "WhoToDraftNext post-season actual player production fixture",
  "type": "object",
  "required": ["schemaVersion", "sourceType", "season", "throughWeek", "complete", "source", "players"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceType": { "const": "actual-player-production" },
    "season": { "const": 2026 },
    "throughWeek": { "type": "integer", "minimum": 1, "maximum": 18 },
    "complete": { "type": "boolean" },
    "source": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string" },
    "notes": { "type": "string" },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "position", "stats"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "position": { "type": "string", "minLength": 1 },
          "team": { "type": ["string", "null"] },
          "games": { "type": ["number", "null"], "minimum": 0 },
          "stats": {
            "type": "object",
            "description": "Scoring-independent season stat line using the same stat vocabulary consumed by the exhaustive production scoring model. Examples: passYds, passTd, passInt, rushYds, rushTd, rec, recYds, recTd, fumLost, fgm, xpm, sacks, ints, fumRec, defTd, solo, ast, pd, ff, fr, tfl, qbHit, safeties, blocks, pa, ya, krYds, prYds.",
            "additionalProperties": { "type": "number" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
